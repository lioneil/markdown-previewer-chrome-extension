{
  "name": "markdown-previewer-chrome-extension",
  "version": "1.0.2",
  "description": "Chrome extension to preview local markdown files",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "build": "wxt build",
    "lint": "tsc --noEmit",
    "package": "wxt build && cd .output/chrome-mv3 && zip -r ../../output.zip .",
    "generate-icons": "node -e \"const sharp=require('sharp'),fs=require('fs'),svg=fs.readFileSync('logo.svg');[16,32,48,128].forEach(s=>sharp(svg).resize(s,s).png().toFile('public/icons/icon-'+s+'.png').then(()=>console.log('icon-'+s+'.png')))\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "chrome-extension",
    "markdown",
    "previewer"
  ],
  "license": "MIT",
  "dependencies": {
    "@mdit/plugin-alert": "^2.0.3",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.16.39",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "wxt": "^0.20.20"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
